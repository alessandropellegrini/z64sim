              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <icon value="images/plus24.png"/>
              <text value=""/>
            </properties>
          </component>
          <component id="579b2" class="javax.swing.JButton" binding="trashButton">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <icon value="images/trash24.png"/>
              <text value=""/>
            </properties>
          </component>
          <component id="20e45" class="javax.swing.JButton" binding="interfaceButton">
