            </children>
          </scrollpane>
        </children>
      </grid>
      <grid id="dcd47" binding="deviceIoBindingPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
