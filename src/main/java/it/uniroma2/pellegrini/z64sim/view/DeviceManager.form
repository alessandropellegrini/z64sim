              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="i18n" key="ivt.table.device"/>
            </properties>
          </component>
          <component id="5b92f" class="javax.swing.JComboBox" binding="deviceEnumeration">
